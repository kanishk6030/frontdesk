# Copy to .env.production, keep that file private, and replace every placeholder.
# All URLs must use the same existing database/host and sslmode=require (or verify-full).
# Migration/runtime passwords must be independent random values of at least 24 characters.
ADMIN_DATABASE_URL=postgresql://frontdesk_admin:replace-admin-password@your-render-host:5432/frontdesk_q7b9?sslmode=require
MIGRATION_DATABASE_URL=postgresql://frontdesk_migration:replace-with-random-migration-password@your-render-host:5432/frontdesk_q7b9?sslmode=require
DATABASE_URL=postgresql://frontdesk_runtime:replace-with-random-runtime-password@your-render-host:5432/frontdesk_q7b9?sslmode=require
