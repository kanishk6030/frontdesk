# Local administrator, operator and runtime secrets are distinct. Run setup-local.js once.
POSTGRES_PASSWORD=replace-with-random-local-admin-secret
DATABASE_URL=postgresql://frontdesk_runtime:replace-runtime-password@127.0.0.1:5432/frontdesk
MIGRATION_DATABASE_URL=postgresql://frontdesk_owner:replace-owner-password@127.0.0.1:5432/frontdesk
TEST_DATABASE_URL=postgresql://frontdesk_test_runtime:replace-test-runtime-password@127.0.0.1:5432/frontdesk_test
TEST_DATABASE_OWNER_URL=postgresql://frontdesk_test_owner:replace-test-owner-password@127.0.0.1:5432/frontdesk_test
SESSION_SECRET=replace-with-at-least-32-random-characters
JOB_TOKEN=replace-with-at-least-32-random-characters
# Operator-only maintenance runner target; do not inject this into browser code.
FRONTDESK_BACKEND_URL=http://localhost:3000
APP_ORIGIN=http://localhost:5173
FRONTDESK_HOLIDAYS=[]
NODE_ENV=development
TZ=UTC
PORT=3000
TRUST_PROXY_HOPS=0
DEMO_AGENT_PASSWORD=replace-demo-agent-password
DEMO_CUSTOMER_PASSWORD=replace-demo-customer-password

# Docker Compose local ingress. Backend/DB remain private on the Compose network.
FRONTDESK_HTTP_PORT=8080
DOCKER_APP_ORIGIN=http://localhost:8080
DOCKER_NODE_ENV=development
