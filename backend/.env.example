# Restricted web-runtime database account only. Never use the migration owner here.
DATABASE_URL=postgresql://frontdesk_runtime:replace-runtime-password@127.0.0.1:5432/frontdesk

# Generate independent random values of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
JOB_TOKEN=replace-with-at-least-32-random-characters

# Exact frontend origin allowed to make state-changing requests.
APP_ORIGIN=http://localhost:5173

# Approved YYYY-MM-DD dates in the Frontdesk working calendar.
FRONTDESK_HOLIDAYS=[]

NODE_ENV=development
TZ=UTC
PORT=3000

# Local direct connection is 0; use 1 only behind one verified trusted proxy.
TRUST_PROXY_HOPS=0
